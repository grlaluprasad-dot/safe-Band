# ==========================================
# SafeBand Backend Production Configuration
# ==========================================

# Core Runtime
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production PostgreSQL Database (e.g. Supabase, Render PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Frontend URL for CORS & Dynamic QR Generation
# Set this to your live frontend URL (e.g. https://safeband.netlify.app or https://safeband.vercel.app)
FRONTEND_BASE_URL=https://safeband.netlify.app
CORS_ORIGINS=https://safeband.netlify.app,https://safeband.vercel.app

# Transactional Email (Resend HTTP API - Recommended for Cloud Hosts)
# Get a free key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@safeband.app

# Alternative: SMTP Email (if host permits outbound SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@safeband.app

# SMS Gateways (Optional)
# Fast2SMS for India:
FAST2SMS_API_KEY=

# Twilio for Global SMS:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
